<Window x:Class="ScanBMC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScanBMC 2.0 — 局域网 BMC 扫描器"
        Width="1220" Height="740"
        MinWidth="920" MinHeight="560"
        Background="#F3F3F3"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <DockPanel LastChildFill="True">
        <!-- 1. 顶部紧凑主工具栏（纯 Windows 原生运维工具风格） -->
        <Border DockPanel.Dock="Top" Background="#F9F9F9" BorderBrush="#DCDCDC" BorderThickness="0,0,0,1" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="目标:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#444444"/>

                <Grid Grid.Column="1">
                    <TextBox x:Name="TargetsBox" Style="{StaticResource CompactInput}"
                             ToolTip="支持 CIDR (192.168.1.0/24)、区间 (10.0.0.1-99)、单 IP，多目标用逗号分隔；留空自动检测本机网段"
                             KeyDown="TargetsBox_KeyDown"/>
                    <TextBlock Text="留空 = 自动检测本机网段" IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#8C8C8C">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TargetsBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button x:Name="StartBtn" Grid.Column="2" Content="开始扫描" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="StartBtn_Click"/>
                <Button x:Name="StopBtn" Grid.Column="3" Content="停止" Style="{StaticResource ToolbarButton}" Margin="6,0,0,0" IsEnabled="False" Click="StopBtn_Click"/>
                <ToggleButton x:Name="AdvancedToggle" Grid.Column="4" Content="高级参数 ▾" Style="{StaticResource ToolbarToggle}" Margin="8,0,0,0" Checked="AdvancedToggle_Changed" Unchecked="AdvancedToggle_Changed"/>

                <!-- 右侧：实时过滤与导出 -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid Width="190" Margin="0,0,8,0">
                        <TextBox x:Name="FilterBox" Style="{StaticResource CompactInput}" TextChanged="FilterChanged"/>
                        <TextBlock Text="筛选 IP / 厂商 / 依据..." IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#8C8C8C">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <CheckBox x:Name="WarnOnlyCheck" Content="仅告警" VerticalAlignment="Center" Margin="0,0,10,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
                    <CheckBox x:Name="ShowAllCheck" Content="含非 BMC 存活主机" VerticalAlignment="Center" Margin="0,0,10,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="7" Orientation="Horizontal">
                    <Button x:Name="ExportCsvBtn" Content="导出 CSV" Style="{StaticResource ToolbarButton}" Margin="0,0,6,0" Click="ExportCsvBtn_Click"/>
                    <Button x:Name="ExportJsonBtn" Content="导出 JSON" Style="{StaticResource ToolbarButton}" Click="ExportJsonBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 可折叠高级参数面板（默认收起，保持主界面清爽） -->
        <Border x:Name="AdvancedPanel" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="#F3F3F3" BorderBrush="#DCDCDC" BorderThickness="0,0,0,1" Padding="10,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                    <TextBlock Text="排除:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#444444"/>
                    <TextBox x:Name="ExcludeBox" Width="150" Style="{StaticResource CompactInput}" ToolTip="要排除的 IP 或网段，格式同目标"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                    <TextBlock Text="TCP 端口:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#444444"/>
                    <TextBox x:Name="PortsBox" Width="220" Style="{StaticResource CompactInput}" FontFamily="Consolas"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                    <TextBlock Text="并发:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#444444"/>
                    <TextBox x:Name="ConcurrencyBox" Width="54" Text="256" Style="{StaticResource CompactInput}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                    <TextBlock Text="超时(秒):" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#444444"/>
                    <TextBox x:Name="TimeoutBox" Width="48" Text="1.0" Style="{StaticResource CompactInput}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                    <TextBlock Text="重试:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#444444"/>
                    <TextBox x:Name="RetriesBox" Width="40" Text="0" Style="{StaticResource CompactInput}"/>
                </StackPanel>
                <CheckBox x:Name="UdpCheck" Content="UDP/623 IPMI" IsChecked="True" VerticalAlignment="Center" Margin="0,2,12,2"/>
                <CheckBox x:Name="WebCheck" Content="Web 指纹" IsChecked="True" VerticalAlignment="Center" Margin="0,2,12,2"/>
                <CheckBox x:Name="RedfishCheck" Content="Redfish" IsChecked="True" VerticalAlignment="Center" Margin="0,2,12,2"/>
                <CheckBox x:Name="ArpOnlyCheck" Content="ARP 快速模式" VerticalAlignment="Center" Margin="0,2,6,2"/>
            </WrapPanel>
        </Border>

        <!-- 3. 底部原生状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F3F3F3" BorderBrush="#DCDCDC" BorderThickness="0,1,0,0" Height="28" Padding="6,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="StatusText" Text="就绪 — 点击「开始扫描」将自动检测本机活动网段" Foreground="#333333"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" Margin="8,0">
                <ProgressBar x:Name="ScanProgressBar" Width="170" Height="12" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" Margin="6,0">
                <TextBlock x:Name="SummaryText" Text="" Foreground="#444444"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 4. 主区域：结果表 + 可拖拽分隔条 + 底部选中行完整详情面板 -->
        <Grid Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="180"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="190" MinHeight="120"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="ResultsGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#ECECEC"
                      AlternatingRowBackground="#FAFAFA"
                      RowBackground="#FFFFFF"
                      BorderThickness="0"
                      RowHeight="28"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      SelectionChanged="ResultsGrid_SelectionChanged"
                      MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="在浏览器中打开管理页 (优先 HTTPS)" Click="CtxOpenPreferred_Click"/>
                        <MenuItem Header="以 HTTPS 打开" Click="CtxOpenHttps_Click"/>
                        <MenuItem Header="以 HTTP 打开" Click="CtxOpenHttp_Click"/>
                        <Separator/>
                        <MenuItem Header="复制 IP 地址" Click="CtxCopyIp_Click"/>
                        <MenuItem Header="复制完整诊断信息" Click="CtxCopyDetails_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                <Setter Property="Background" Value="#FFF8E6"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CCE4F7"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="IP 地址" Binding="{Binding Ip}" Width="130" SortMemberPath="IpSortKey">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="Foreground" Value="#005A9E"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="置信度" Width="72" SortMemberPath="ConfidenceRank">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="2" Padding="6,1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{Binding ConfidenceBg}" BorderBrush="{Binding ConfidenceBorder}" BorderThickness="1">
                                    <TextBlock Text="{Binding ConfidenceDisplay}" Foreground="{Binding ConfidenceFg}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="设备类型" Binding="{Binding VendorDisplay}" Width="185">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="开放端口" Binding="{Binding OpenPorts}" Width="210">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="告警" Binding="{Binding WarningSummary}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#9A5B00"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="判定依据" Binding="{Binding EvidenceSummary}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="Foreground" Value="#444444"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#E5E5E5" ResizeBehavior="PreviousAndNext"/>

            <!-- 底部选中行详情面板（完整显示所有协议细节与判定依据，不再被截断） -->
            <Border Grid.Row="2" Background="#FAFAFA" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="OpenBrowserBtn" Content="打开管理页" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="CtxOpenPreferred_Click" Margin="0,0,6,0"/>
                            <Button x:Name="CopyIpBtn" Content="复制 IP" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="CtxCopyIp_Click" Margin="0,0,6,0"/>
                            <Button x:Name="CopyDetailBtn" Content="复制详情" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="CtxCopyDetails_Click"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="设备概览" FontWeight="SemiBold" Foreground="#222222" Margin="0,0,0,6"/>
                            <TextBox x:Name="DetailOverviewBox"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="Consolas, Microsoft YaHei UI"
                                     FontSize="12.5"
                                     TextWrapping="Wrap"
                                     Foreground="#333333"
                                     Text="选中上方列表中的任意设备查看完整协议与证书详情（双击可直接打开管理页）。"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Column="1" Width="1" Background="#E0E0E0" HorizontalAlignment="Center"/>

                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="完整判定依据与协议详情" FontWeight="SemiBold" Foreground="#222222" Margin="0,0,0,6"/>
                        <TextBox x:Name="DetailEvidenceBox"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="#FFFFFF"
                                 BorderBrush="#DCDCDC"
                                 BorderThickness="1"
                                 Padding="8,6"
                                 FontFamily="Consolas, Microsoft YaHei UI"
                                 FontSize="12.5"
                                 TextWrapping="Wrap"
                                 Foreground="#222222"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
