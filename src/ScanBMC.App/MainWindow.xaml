<Window x:Class="ScanBMC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScanBMC"
        Icon="Assets/scanbmc.ico"
        Width="1260" Height="760"
        MinWidth="960" MinHeight="580"
        Background="{StaticResource CanvasBgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <DockPanel LastChildFill="True">
        <!-- 1. 顶部 Windows 11 CommandBar 工具栏 -->
        <Border DockPanel.Dock="Top" Background="#F9F9F9" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="扫描目标" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>

                <Grid Grid.Column="1">
                    <TextBox x:Name="TargetsBox"
                             Style="{StaticResource FluentTextBox}"
                             Padding="8,0,28,0"
                             Tag="留空自动检测本机网段，如 192.168.1.0/24"
                             ToolTip="支持 CIDR (192.168.1.0/24)、区间 (10.0.0.1-99)、单 IP，多个用逗号分隔；留空将自动检测本机活动网段"
                             KeyDown="TargetsBox_KeyDown"/>
                    <Button x:Name="DetectNetBtn"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,3,0" Width="24" Height="24" Padding="0"
                            Style="{StaticResource FluentSubtleButton}"
                            ToolTip="自动检测并填入本机活动网段"
                            Click="DetectNetBtn_Click">
                        <Path Data="M 12,4 A 8,8 0 1 0 19.5,14.5 M 19.5,4 L 19.5,9.5 L 14,9.5"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                              Stretch="Uniform" Width="12" Height="12"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                </Grid>

                <Button x:Name="StartBtn" Grid.Column="2" Style="{StaticResource FluentPrimaryButton}" Margin="8,0,0,0" Click="StartBtn_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 0,0 L 8,5 L 0,10 Z" Fill="#FFFFFF" Width="8" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="开始扫描" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="StopBtn" Grid.Column="3" Style="{StaticResource FluentButton}" Margin="6,0,0,0" IsEnabled="False" Click="StopBtn_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="8" Height="8" RadiusX="1" RadiusY="1" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="#C42B1C"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled, ElementName=StopBtn}" Value="False">
                                            <Setter Property="Fill" Value="#B0B0B0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <TextBlock Text="停止" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <ToggleButton x:Name="AdvancedToggle" Grid.Column="4" Style="{StaticResource FluentToggleButton}" Margin="8,0,0,0"
                              Checked="AdvancedToggle_Changed" Unchecked="AdvancedToggle_Changed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AdvancedToggleText" Text="选项 ▾" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <!-- 右侧：筛选分段控件 + 搜索框 + 导出菜单 -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,8,0">
                    <!-- 3 段式视图切换 -->
                    <Border Background="#EDEDED" CornerRadius="4" Padding="2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeBmcRadio" Content="BMC" IsChecked="True" Style="{StaticResource SegmentRadioButton}" Checked="FilterChanged"/>
                            <RadioButton x:Name="ModeWarnRadio" Content="告警" Style="{StaticResource SegmentRadioButton}" Checked="FilterChanged"/>
                            <RadioButton x:Name="ModeAllRadio" Content="全部存活" Style="{StaticResource SegmentRadioButton}" Checked="FilterChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 带放大镜图标的搜索框 -->
                    <Grid Width="210">
                        <TextBox x:Name="FilterBox"
                                 Style="{StaticResource FluentTextBox}"
                                 Padding="26,0,8,0"
                                 Tag="筛选 IP、厂商、端口或依据..."
                                 TextChanged="FilterChanged"/>
                        <Path Data="M 6,1 A 5,5 0 1 0 6,11 A 5,5 0 1 0 6,1 M 9.8,9.8 L 13,13"
                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4"
                              Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"
                              IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>

                <Button x:Name="ExportMenuBtn" Grid.Column="6" Style="{StaticResource FluentButton}" Click="ExportMenuBtn_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="导出 ▾" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ExportContextMenu">
                            <MenuItem Header="导出为 CSV 表格（Excel 兼容）" Click="ExportCsvBtn_Click"/>
                            <MenuItem Header="导出为 JSON 数据" Click="ExportJsonBtn_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <!-- 2. 可折叠高级选项面板（默认收起） -->
        <Border x:Name="AdvancedPanel" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="#F4F4F4" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="14,9">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                    <TextBlock Text="排除" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBox x:Name="ExcludeBox" Width="145" Style="{StaticResource FluentTextBox}" Tag="如 192.168.1.1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                    <TextBlock Text="TCP 端口" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBox x:Name="PortsBox" Width="215" Style="{StaticResource FluentTextBox}" FontFamily="Consolas"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                    <TextBlock Text="并发" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBox x:Name="ConcurrencyBox" Width="56" Text="256" Style="{StaticResource FluentTextBox}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                    <TextBlock Text="超时(s)" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBox x:Name="TimeoutBox" Width="50" Text="1.0" Style="{StaticResource FluentTextBox}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2" VerticalAlignment="Center">
                    <TextBlock Text="重试" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBox x:Name="RetriesBox" Width="44" Text="0" Style="{StaticResource FluentTextBox}"/>
                </StackPanel>
                <CheckBox x:Name="UdpCheck" Content="UDP/623 IPMI" IsChecked="True" Style="{StaticResource FluentCheckBox}" Margin="0,2,14,2"/>
                <CheckBox x:Name="WebCheck" Content="Web 指纹" IsChecked="True" Style="{StaticResource FluentCheckBox}" Margin="0,2,14,2"/>
                <CheckBox x:Name="RedfishCheck" Content="Redfish" IsChecked="True" Style="{StaticResource FluentCheckBox}" Margin="0,2,14,2"/>
                <CheckBox x:Name="ArpOnlyCheck" Content="仅扫描 ARP 邻居" Style="{StaticResource FluentCheckBox}" Margin="0,2,4,2"/>
            </WrapPanel>
        </Border>

        <!-- 3. 底部纤细状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="#F9F9F9" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Height="30" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="就绪 — 点击「开始扫描」自动发现局域网内的 BMC 设备（纯只读探测）"/>

                <ProgressBar x:Name="ScanProgressBar" Grid.Column="1" Width="180" Margin="12,0"
                             Style="{StaticResource FluentProgressBar}" VerticalAlignment="Center" Visibility="Collapsed"/>

                <TextBlock x:Name="SummaryText" Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </Border>

        <!-- 4. 主工作区：两张圆角白卡片（上：设备表 / 下：结构化设备检查器） -->
        <Grid Margin="12,10,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="218" MinHeight="150"/>
            </Grid.RowDefinitions>

            <!-- 上卡片：结果表格 + 空状态占位 -->
            <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="ResultsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              AlternationCount="2"
                              BorderThickness="0"
                              Background="Transparent"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              ColumnHeaderStyle="{StaticResource FluentColumnHeaderStyle}"
                              CellStyle="{StaticResource FluentCellStyle}"
                              RowStyle="{StaticResource FluentRowStyle}"
                              SelectionChanged="ResultsGrid_SelectionChanged"
                              MouseDoubleClick="ResultsGrid_MouseDoubleClick">

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开管理页（自动选择协议）" Click="CtxOpenPreferred_Click"/>
                                <MenuItem Header="以 HTTPS 打开" Click="CtxOpenHttps_Click"/>
                                <MenuItem Header="以 HTTP 打开" Click="CtxOpenHttp_Click"/>
                                <Separator/>
                                <MenuItem Header="复制 IP 地址" Click="CtxCopyIp_Click"/>
                                <MenuItem Header="复制完整设备报告" Click="CtxCopyDetails_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP 地址" Binding="{Binding Ip}" Width="136" SortMemberPath="IpSortKey">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#005A9E"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="置信度" Width="80" SortMemberPath="ConfidenceRank">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{Binding ConfidenceBg}" BorderBrush="{Binding ConfidenceBorder}" BorderThickness="1">
                                            <TextBlock Text="{Binding ConfidenceDisplay}" Foreground="{Binding ConfidenceFg}" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="设备类型" Binding="{Binding VendorDisplay}" Width="185">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="开放端口" Binding="{Binding CompactPorts}" Width="195">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="告警" Width="210" SortMemberPath="WarningCount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{Binding WarningBg}" BorderBrush="{Binding WarningBorder}" BorderThickness="1"
                                                Visibility="{Binding WarningVisibility}">
                                            <TextBlock Text="{Binding WarningShort}" Foreground="{Binding WarningFg}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="协议摘要" Binding="{Binding ProtocolSummary}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 空状态简洁引导 -->
                    <StackPanel x:Name="EmptyOverlay" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="44" Height="44" CornerRadius="8" Background="#F4F6F9" BorderBrush="#E4E8EE" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Path Data="M 3,5 L 17,5 L 17,9 L 3,9 Z M 3,11 L 17,11 L 17,15 L 3,15 Z"
                                  Stroke="#6C8299" StrokeThickness="1.4" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="暂无扫描结果" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptySubtitle" Text="点击顶部「开始扫描」自动检测本机网段，或手动输入 CIDR / IP 区间" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 中间纤细拖拽分隔条 -->
            <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Cursor="SizeNS">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border Width="36" Height="3" CornerRadius="1.5" Background="#D0D0D0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- 下卡片：结构化设备检查器（Inspector） -->
            <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <!-- 检查器顶部标题条 + 快捷操作 -->
                    <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#ECECEC" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0" Padding="14,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="InspectorTitle" Text="设备详情" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="InspectorVendor" Text="" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="OpenBrowserBtn" Content="打开管理页" Style="{StaticResource FluentSubtleButton}" IsEnabled="False" Click="CtxOpenPreferred_Click" Margin="0,0,4,0"/>
                                <Button x:Name="CopyIpBtn" Content="复制 IP" Style="{StaticResource FluentSubtleButton}" IsEnabled="False" Click="CtxCopyIp_Click" Margin="0,0,4,0"/>
                                <Button x:Name="CopyDetailBtn" Content="复制报告" Style="{StaticResource FluentSubtleButton}" IsEnabled="False" Click="CtxCopyDetails_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 检查器主体：左侧整齐属性表 / 右侧结构化证据列表 -->
                    <Grid Margin="14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左栏：严格对齐的两列 Grid 属性表 -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                            <Grid x:Name="PropertyGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="管理地址" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="6,3">
                                    <Hyperlink x:Name="PropUrlLink" Click="CtxOpenPreferred_Click" TextDecorations="None">
                                        <Run x:Name="PropUrlText" Text="—" FontFamily="Consolas" FontSize="12" Foreground="#005A9E"/>
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="开放端口" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3"/>
                                <TextBlock x:Name="PropPortsText" Grid.Row="1" Grid.Column="1" Text="—" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="6,3"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="IPMI 能力" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3"/>
                                <TextBlock x:Name="PropIpmiText" Grid.Row="2" Grid.Column="1" Text="—" FontSize="12" TextWrapping="Wrap" Margin="6,3"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="固件信息" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3"/>
                                <TextBlock x:Name="PropFirmwareText" Grid.Row="3" Grid.Column="1" Text="—" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap" Margin="6,3"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Redfish" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3"/>
                                <TextBlock x:Name="PropRedfishText" Grid.Row="4" Grid.Column="1" Text="—" FontSize="12" TextWrapping="Wrap" Margin="6,3"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="TLS 证书" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3"/>
                                <TextBlock x:Name="PropCertText" Grid.Row="5" Grid.Column="1" Text="—" FontSize="12" TextWrapping="Wrap" Margin="6,3"/>
                            </Grid>
                        </ScrollViewer>

                        <Border Grid.Column="1" Background="#EAEAEA"/>

                        <!-- 右栏：结构化判定依据与告警清单 -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="14,0,4,0">
                            <ItemsControl x:Name="EvidenceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Bg}" BorderBrush="{Binding Border}" BorderThickness="{Binding BorderThickness}"
                                                CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                            <DockPanel>
                                                <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding Text, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{Binding Fg}"
                                                         FontFamily="Consolas, Microsoft YaHei UI"
                                                         FontSize="12"
                                                         TextWrapping="Wrap"
                                                         Padding="0"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
