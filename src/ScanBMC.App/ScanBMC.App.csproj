<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>2.0.0</Version>
    <AssemblyName>ScanBMC</AssemblyName>
    <RootNamespace>ScanBMC.App</RootNamespace>
    <Product>ScanBMC</Product>
    <Description>Read-only LAN BMC discovery tool for Windows</Description>
    <ApplicationIcon>Assets\scanbmc.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\scanbmc.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScanBMC.Core\ScanBMC.Core.csproj" />
  </ItemGroup>

</Project>
